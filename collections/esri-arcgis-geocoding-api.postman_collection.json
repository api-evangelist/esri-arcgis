          "name": "Geocode an address",
          "request": {
            "name": "Geocode an address",
            "description": {
              "content": "Converts address text into geographic coordinates (forward geocoding). Returns a list of address candidates with location coordinates and match scores.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "arcgis",
                "rest",
                "services",
                "World",
                "GeocodeServer",
                "findAddressCandidates"
              ],
              "host": [
                "geocode",
                "arcgis",
                "com"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "SingleLine",
                  "value": "<string>",
                  "description": "Single-line address string (e.g., \"380 New York St, Redlands, CA 92373\")"
                },
                {
                  "disabled": false,
                  "key": "Address",
                  "value": "<string>",
                  "description": "Street address component"
                },
                {
                  "disabled": false,
                  "key": "City",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "Region",
                  "value": "<string>",
                  "description": "State or province"
                },
                {
                  "disabled": false,
                  "key": "Postal",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "CountryCode",
                  "value": "<string>",
                  "description": "ISO 3166-1 alpha-2 or alpha-3 country code"
                },
                {
                  "disabled": false,
                  "key": "maxLocations",
                  "value": "1"
                },
                {
                  "disabled": false,
                  "key": "outFields",
                  "value": "<string>",
                  "description": "Comma-separated list of output fields (* for all)"
                },
                {
                  "disabled": false,
                  "key": "outSR",
                  "value": "4326",
                  "description": "Output spatial reference WKID"
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "f",
                  "value": "json"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
